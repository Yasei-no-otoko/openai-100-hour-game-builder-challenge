# Defaults to local deterministic mock. No key needed to deploy a mock preview.
AI_MODE=mock
# Live private pilot only. Configure on the server, never in HTML or client JS.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_ORIGIN=https://your-private-preview.vercel.app
PILOT_ACCESS_TOKEN=
# PILOT_ACCESS_TOKEN: generate a random 32-byte hex token. Enter only in memory in the pilot UI.
# Before public live release: real user auth, durable per-user quota, global spend cap.
